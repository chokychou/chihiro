[
    {
        "id": 1,
        "priority": 1,
        "action": {
            "type": "modifyHeaders",
            "responseHeaders": [
                {
                    "header": "x-frame-options",
                    "operation": "remove"
                },
                {
                    "header": "content-security-policy-report-only",
                    "operation": "remove"
                },
                {
                    "header": "content-security-policy",
                    "operation": "remove"
                },
                {
                    "header": "set-cookie",
                    "operation": "set",
                    "value": "${header}; Secure; SameSite=None"
                }
            ]
        },
        "condition": {
            "urlFilter": "*://*/*",
            "resourceTypes": [
                "sub_frame",
                "xmlhttprequest"
            ]
        }
    }
]