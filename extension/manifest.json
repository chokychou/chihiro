{
    "author": "Yi Zhou",
    "manifest_version": 3,
    "name": "Chihiro",
    "version": "1.0",
    "description": "LLM search in side panel extension",
    "icons": {
        "16": "images/icon16.png",
        "32": "images/icon32.png",
        "48": "images/icon48.png",
        "128": "images/icon128.png"
    },
    "background": {
        "service_worker": "service-worker.js"
    },
    "action": {
        "default_title": "Click to open Chihiro"
    },
    "options_page": "options.html",
    "side_panel": {
        "default_path": "sidepanel.html"
    },
    "host_permissions": [
        "https://*/*",
        "http://*/*",
        "wss://*/*",
        "ws://*/*"
    ],
    "permissions": [
        "sidePanel",
        "storage",
        "tabs",
        "declarativeNetRequest"
    ],
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "ruleset_1",
                "enabled": true,
                "path": "rules.json"
            }
        ]
    }
}